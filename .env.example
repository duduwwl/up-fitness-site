# Public browser configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only Supabase project. Use distinct projects for preview and production.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_example
SUPABASE_ENVIRONMENT=development

# Server-only abuse protection and Turnstile validation
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ALLOWED_ORIGINS=http://localhost:3000

# Local E2E only. Never configure on Vercel.
E2E_MOCK_SUBMISSIONS=false

# Pagamentos online — Stone (plataforma Pagar.me). SCAFFOLD desligado por padrão.
# Só deixe PAYMENTS_ENABLED=true depois de configurar as chaves e aplicar a migration.
PAYMENTS_ENABLED=false
STONE_API_KEY=
STONE_PUBLIC_KEY=
STONE_WEBHOOK_SECRET=
STONE_API_BASE_URL=https://api.pagar.me/core/v5
